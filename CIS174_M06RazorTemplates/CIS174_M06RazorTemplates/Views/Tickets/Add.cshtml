@model CIS174_M06RazorTemplates.Models.Ticket

@{
    ViewData["Title"] = "Add Ticket";
}

<h2>Add New Ticket</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-controller="Tickets" asp-action="Add" method="post">
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Ticket Name:</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description:</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SprintNumber" class="form-label">Sprint Number:</label>
        <input asp-for="SprintNumber" type="number" min="1" class="form-control" />
        <span asp-validation-for="SprintNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PointValue" class="form-label">Point Value:</label>
        <input asp-for="PointValue" type="number"min="1" class="form-control" />
        <span asp-validation-for="PointValue" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label">Status:</label>
        <select asp-for="Status" class="form-select">
            <option value="To Do">To Do</option>
            <option value="In Progress">In Progress</option>
            <option value="QA">Quality Assurance (QA)</option>
            <option value="Done">Done</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        Add Ticket
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>