@model IEnumerable<CIS174_M06RazorTemplates.Models.Ticket>

@{
    ViewData["Title"] = "My Tickets";
}

<h2 class="text-center mt-3">My Tickets</h2>

<div class="mb-3">
    <a asp-action="Add" class="btn btn-primary">Add New Ticket</a>
</div>

@if (!Model.Any())
{
    <p>No tickets have been added yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Sprint</th>
                    <th>Points</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var ticket in Model)
                {
                    <tr>
                        <td>@ticket.Name</td>
                        <td>@ticket.Description</td>
                        <td>@ticket.SprintNumber</td>
                        <td>@ticket.PointValue</td>
                        <td>@ticket.Status</td>

                        <td>
                            <form asp-action="UpdateStatus"
                                  method="post" class="mb-2">

                                <input type="hidden" name="id" value="@ticket.Id" />

                                <select name="status" class="form-select mb-2">
                                    @if (ticket.Status == "To Do")
                                    {
                                        <option value="To Do" selected>To Do</option>
                                    }
                                    else
                                    {
                                        <option value="To Do">To Do</option>
                                    }

                                    @if (ticket.Status == "In Progress")
                                    {
                                        <option value="In Progress" selected>In Progress</option>
                                    }
                                    else
                                    {
                                        <option value="In Progress">In Progress</option>
                                    }

                                    @if (ticket.Status == "QA")
                                    {
                                        <option value="QA" selected>Quality Assurance (QA)</option>
                                    }
                                    else
                                    {
                                        <option value="QA">Quality Assurance (QA)</option>
                                    }

                                    @if (ticket.Status == "Done")
                                    {
                                        <option value="Done" selected>Done</option>
                                    }
                                    else
                                    {
                                        <option value="Done">Done</option>
                                    }
                                </select>

                                <button type="submit" class="btn btn-success btn-sm">
                                    Update Status
                                </button>
                            </form>

                            <form asp-action="Delete" method="post">
                                <input type="hidden" name="id" value="@ticket.Id" />

                                <button type="submit" class="btn btn-danger btn-sm">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a asp-controller="Assignment7_1"
       asp-action="Index"
       class="btn btn-outline-primary">
        Return to Olympic Games
    </a>
</div>