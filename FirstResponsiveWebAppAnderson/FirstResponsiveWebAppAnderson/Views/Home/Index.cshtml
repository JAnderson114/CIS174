@{
}
@model FirstResponsiveWebAppLastName.Models.UserModel

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Age Calculator</title>

    <style>
            body {
                font-family: Arial;
                background-color: lightblue;
            }

            .box {
                width: 80%;
                max-width: 500px;
                margin: 20px auto;
                padding: 20px;
                background-color: white;
            }

            label {
                display: block;
                margin-top: 10px;
            }

            input {
                width: 95%;
                padding: 5px;
            }

            button {
                margin-top: 10px;
            }

            .error {
                color: red;
            }

            .message {
                color: green;
            }
    </style>
</head>

<body>

    <div class="box">

        <h1>Age Calculator</h1>

        <form method="post">

            <label>Name:</label>
            <input type="text" asp-for="Name" />

            @if (ViewData.ModelState["Name"] != null &&
                 ViewData.ModelState["Name"].Errors.Count > 0)
            {
                <p class="error">Please enter your name.</p>
            }

            <label>Year of Birth:</label>
            <input type="number" asp-for="BirthYear" />

            @if (ViewData.ModelState["BirthYear"] != null &&
                 ViewData.ModelState["BirthYear"].Errors.Count > 0)
            {
                <p class="error">Please enter your birth year.</p>
            }

            <br />

            <button type="submit">Submit</button>
            <button type="reset">Clear</button>

        </form>

        @if (ViewBag.Message != null)
        {
            <p class="message">
                @ViewBag.Message
            </p>
        }

    </div>

</body>
</html>